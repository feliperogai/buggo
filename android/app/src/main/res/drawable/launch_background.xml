<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativa (Android < 12): só o fundo branco, sem o ícone.
     A primeira coisa que o usuário deve ver é a animação Lottie da
     SplashScreen do Flutter, então aqui ficamos com a mesma cor de fundo
     dela (AppColors.surface) para a transição não piscar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
</layer-list>
