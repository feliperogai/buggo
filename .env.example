# Copie este arquivo para ".env" e preencha. O `.env` é asset do app
# (pubspec.yaml), então precisa existir para `flutter build` rodar.

# URL do backend (Vercel) publicado a partir da pasta server/ — veja
# server/README.md. Deixar em branco não quebra mais nada: o app cai na URL
# de produção embutida em lib/core/config/env_config.dart. Preencha só para
# apontar para outro ambiente.
API_BASE_URL=

# Client ID OAuth do tipo "Web" criado no Google Cloud (APIs e Serviços >
# Credenciais). É o mesmo valor que vai em GOOGLE_WEB_CLIENT_ID no servidor.
# Sem ele o botão "Continuar com Google" não aparece.
GOOGLE_SERVER_CLIENT_ID=

# As duas chaves também podem ser passadas na hora do build, e nesse caso
# vencem o que estiver no .env — é assim que uma pipeline sem o arquivo
# consegue gerar um APK completo:
#
#   flutter build appbundle \
#     --dart-define=API_BASE_URL=https://buggo-api.vercel.app \
#     --dart-define=GOOGLE_SERVER_CLIENT_ID=...

# Bloco de anúncio RECOMPENSADO do AdMob (recarregar vidas assistindo vídeo).
# Vazio faz o app usar os IDs de teste do Google: os anúncios aparecem e a
# recompensa funciona, mas não geram receita. Formato:
# ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
ADMOB_REWARDED_AD_UNIT_ID=
