# Copie este arquivo para ".env" e preencha com a URL do backend (Vercel)
# publicado a partir da pasta server/ (veja server/README.md).
# Sem essa chave, o app funciona só no modo convidado, com ranking de exemplo.
API_BASE_URL=

# OAuth *Web* client ID do projeto no Google Cloud (termina em
# ".apps.googleusercontent.com"). Não use o client ID Android aqui — é este
# que vira a audiência do ID token e que o backend valida.
# Enquanto estiver vazio, o botão "Entrar com Google" não aparece.
GOOGLE_SERVER_CLIENT_ID=

# Unidade de anúncio premiado do AdMob (formato ca-app-pub-.../...).
# Em debug a unidade de teste do Google é sempre usada, independente do valor
# aqui — usar a unidade real em desenvolvimento causa suspensão da conta.
ADMOB_REWARDED_AD_UNIT_ID=
