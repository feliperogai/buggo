# Copie para ".env" (uso local com `vercel dev`) e/ou configure estas mesmas
# chaves nas Environment Variables do projeto na Vercel. NUNCA coloque este
# arquivo preenchido no app Flutter nem no repositório.

# Connection string do Neon (Project > Connection Details). Mantenha
# "channel_binding=require" e "sslmode=require" como o Neon fornece.
DATABASE_URL=

# Segredo usado para assinar os tokens de sessão (JWT). Gere uma string
# aleatória longa, ex: `openssl rand -hex 32`.
JWT_SECRET=

# Conta Gmail usada para enviar e-mails de recuperação de senha. Requer uma
# "Senha de app" (App Password) gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL pública onde este backend está publicado na Vercel (sem barra no
# final). Usada para montar o link de redefinição de senha enviado por
# e-mail, ex: https://buggo-api.vercel.app
APP_URL=

# ── Login com Google ─────────────────────────────────────────────────────
# Client ID OAuth do tipo "Web" (Google Cloud > APIs e Serviços >
# Credenciais). É a audiência que o backend exige no token do Google. O MESMO
# valor vai em GOOGLE_SERVER_CLIENT_ID no .env do app Flutter. Não é o client
# ID do tipo Android — esse não vai em lugar nenhum, só precisa existir.
GOOGLE_WEB_CLIENT_ID=

# ── Compras do Google Play ───────────────────────────────────────────────
# Nome do pacote do app, igual ao applicationId do build.gradle.kts.
ANDROID_PACKAGE_NAME=com.buggo.app

# JSON da service account (Google Cloud > IAM > Contas de serviço > Chaves >
# Adicionar chave > JSON) com acesso à Play Developer API, colado INTEIRO em
# uma linha. É o que permite ao servidor confirmar cada compra com o Google.
PLAY_SERVICE_ACCOUNT_JSON=

# ── Desafio do dia (duas IAs) ────────────────────────────────────────────
# Uma escreve o desafio, a outra revisa. São de casas diferentes de
# propósito: modelo que revisa a si mesmo concorda consigo mesmo.
#
# Sem as duas chaves o desafio simplesmente não é gerado — o app não mostra o
# cartão e o resto continua funcionando. O revisor é obrigatório: publicar
# direto o que um modelo escreveu, com moeda no fim, é justamente o que a
# revisão existe para evitar.

# Gerador: DeepSeek (platform.deepseek.com > API keys).
DEEPSEEK_API_KEY=
# Opcionais. O padrão é deepseek-chat na API compatível com a da OpenAI.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Revisor: OpenAI (platform.openai.com > API keys).
OPENAI_API_KEY=
# Opcional. Sem isto o padrão é gpt-4o-mini — confira o catálogo atual antes
# de fixar, os modelos mudam mais rápido que este arquivo.
OPENAI_MODEL=
OPENAI_BASE_URL=
